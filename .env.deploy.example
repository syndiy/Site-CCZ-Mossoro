# Copie para .env e preencha senhas exclusivas antes de executar o compose.
# Esta pasta isolada contem origin/feat/conteudo e as correcoes da auditoria.
CCZ_BACKEND_PATH=../_ccz-back-mvp
NEXT_PUBLIC_API_URL=/api
# Na VPS, vazio deriva automaticamente https://SITE_DOMAIN.
# Para dominios adicionais, separe as origens por virgula.
CORS_ALLOWED_ORIGINS=
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=
MINIO_ACCESS_KEY=ccz-storage
MINIO_SECRET_KEY=

# Para deploy em uma VPS usando docker-compose.vps.yml
SITE_DOMAIN=
