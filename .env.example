# Endereco do backend Spring. Uma unica variavel liga tudo que fala com a API:
# o formulario de denuncia, o painel /admin e as publicacoes que o site mostra
# antes do proximo build.
#
# Sem valor, usa /api na mesma origem (proxy nginx em producao).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Build: endereço público do site, usado em links canônicos, sitemap, feed RSS,
# llms.txt e dados estruturados. Sem valor, usa https://ccz.mossoro.rn.gov.br.
NEXT_PUBLIC_SITE_URL=

# Build: API de onde scripts/sincronizar-conteudo.mjs traz as notícias e artigos
# publicados no painel, para virarem páginas HTML prontas (SEO). Endereço completo
# (ex.: https://servidor/api). Sem valor, o build usa só o que está em content/.
CONTENT_API_URL=
