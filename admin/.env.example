# --- Login da equipe (Spring Security do backend) ---
# Endereco da API. Com ele definido, o editor autentica em POST /users/login.
CCZ_API_URL=http://localhost:8080
# Mesmo segredo do JwtTokenService no backend, usado para validar o token.
CCZ_JWT_SECRET=troque-para-o-segredo-do-backend
# Emissor do token. So mude se mudar no backend.
CCZ_JWT_ISSUER=SiteInstitucionalCcz

# --- Acesso local provisorio (usado apenas quando CCZ_API_URL nao esta definido) ---
# Senha unica de acesso ao editor.
ADMIN_PASSWORD=troque-esta-senha
# Segredo usado para invalidar as sessoes quando for alterado.
ADMIN_SESSION_SECRET=troque-este-segredo-longo
